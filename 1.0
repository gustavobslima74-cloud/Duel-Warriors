Instance.new("UICorner", svHeader).CornerRadius = UDim.new(0, 10)

local svStatus = Instance.new("TextLabel", tabs.Servers)
svStatus.Size = UDim2.new(1, 0, 0, 22)
svStatus.BackgroundTransparency = 1
svStatus.Font = Enum.Font.Gotham
svStatus.TextSize = 11
svStatus.TextColor3 = Theme.SubText
svStatus.Text = "Servidor atual: " .. tostring(game.JobId):sub(1, 8) .. "..."
svStatus.TextXAlignment = Enum.TextXAlignment.Left

local function fetchServers()
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?limit=100", game.PlaceId)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if not ok or not res then return nil end
    local ok2, decoded = pcall(function() return HttpService:JSONDecode(res) end)
    if not ok2 or not decoded then return nil end
    return decoded.data
end

local function setStatus(msg)
    svStatus.Text = msg
    task.delay(4, function()
        if svStatus.Text == msg then
            svStatus.Text = "Servidor atual: " .. tostring(game.JobId):sub(1, 8) .. "..."
        end
    end)
end

local function joinServer(jobId)
    if not jobId or jobId == "" then return end
    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, LocalPlayer)
    end)
    if not ok then setStatus("Erro ao teleportar: " .. tostring(err)) end
end

createSection(tabs.Servers, "Ações Rápidas")

createActionButton(tabs.Servers, "Rejoin (Servidor Atual)", Theme.Accent, function()
    setStatus("Reentrando no servidor atual...")
    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end)
    if not ok then setStatus("Erro: " .. tostring(err)) end
end)

createActionButton(tabs.Servers, "Entrar em Servidor Aleatório", Theme.Card, function()
    setStatus("Buscando servidores...")
    local servers = fetchServers()
    if not servers or #servers == 0 then setStatus("Nenhum servidor encontrado.") return end
    local list = {}
    for _, s in ipairs(servers) do
        if s.id ~= game.JobId and s.playing < s.maxPlayers then
            table.insert(list, s)
        end
    end
    if #list == 0 then setStatus("Nenhum servidor com vaga disponível.") return end
    joinServer(list[math.random(1, #list)].id)
end)

createActionButton(tabs.Servers, "Servidor com Menor Ping (Proxy de BR)", Theme.Card, function()
    setStatus("Buscando servidores com melhor ping...")
    local servers = fetchServers()
    if not servers then setStatus("Falha ao buscar servidores.") return end
    local best, bestPing = nil, math.huge
    for _, s in ipairs(servers) do
        if s.id ~= game.JobId and s.playing < s.maxPlayers then
            local p = tonumber(s.ping) or math.huge
            if p < bestPing then bestPing = p; best = s end
        end
    end
    if not best then setStatus("Nenhum servidor adequado encontrado.") return end
    setStatus("Entrando em servidor com ping ~" .. tostring(math.floor(bestPing)) .. "ms")
    joinServer(best.id)
end)

createActionButton(tabs.Servers, "Servidor Brasileiro (se encontrado)", Theme.Card, function()
    setStatus("Procurando servidor brasileiro...")
    local servers = fetchServers()
    if not servers then setStatus("Falha ao buscar servidores.") return end
    local br = nil
    for _, s in ipairs(servers) do
        local region = (s.region or ""):lower()
        if s.id ~= game.JobId and s.playing < s.maxPlayers and (string.find(region, "brazil") or string.find(region, "br") or string.find(region, "south america")) then
            br = s
            break
        end
    end
    if br then
        setStatus("Servidor BR encontrado! Entrando...")
        joinServer(br.id)
    else
        setStatus("Nenhum BR detectado. Usando melhor ping como fallback.")
        local best, bestPing = nil, math.huge
        for _, s in ipairs(servers) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                local p = tonumber(s.ping) or math.huge
                if p < bestPing then bestPing = p; best = s end
            end
        end
        if best then joinServer(best.id) end
    end
end)

createSection(tabs.Servers, "Entrar por Job ID")

local jobFrame = Instance.new("Frame", tabs.Servers)
jobFrame.Size = UDim2.new(1, 0, 0, 46)
jobFrame.BackgroundColor3 = Theme.Card
jobFrame.BorderSizePixel = 0
Instance.new("UICorner", jobFrame).CornerRadius = UDim.new(0, 10)

local jobBox = Instance.new("TextBox", jobFrame)
jobBox.Size = UDim2.new(1, -100, 0, 32)
jobBox.Position = UDim2.new(0, 8, 0.5, -16)
jobBox.BackgroundColor3 = Theme.Background
jobBox.Text = ""
jobBox.PlaceholderText = "Cole o Job ID aqui..."
jobBox.TextColor3 = Theme.Text
jobBox.PlaceholderColor3 = Theme.SubText
jobBox.Font = Enum.Font.Gotham
jobBox.TextSize = 12
jobBox.TextXAlignment = Enum.TextXAlignment.Left
jobBox.ClearTextOnFocus = false
