-- ===== WHITELIST (2ª aba) =====
local wlHeader = Instance.new("TextLabel", tabs.Whitelist)
wlHeader.Size = UDim2.new(1, 0, 0, 32)
wlHeader.BackgroundColor3 = Theme.Card
wlHeader.Font = Enum.Font.GothamMedium
wlHeader.TextSize = 11
wlHeader.TextColor3 = Theme.SubText
wlHeader.TextWrapped = true
wlHeader.Text = "★ = Amigo (no topo)  •  Toque no card para marcar como ignorado."
Instance.new("UICorner", wlHeader).CornerRadius = UDim.new(0, 10)

local wlContainer = Instance.new("Frame", tabs.Whitelist)
wlContainer.Size = UDim2.new(1, 0, 0, 0)
wlContainer.AutomaticSize = Enum.AutomaticSize.Y
wlContainer.BackgroundTransparency = 1
local wlLayout = Instance.new("UIListLayout", wlContainer)
wlLayout.Padding = UDim.new(0, 6)
wlLayout.SortOrder = Enum.SortOrder.LayoutOrder

local wlBtnCache = {}
local friendCache = {} -- [userId] = bool

local function isFriend(p)
    if friendCache[p.UserId] == nil then
        local ok, res = pcall(function() return LocalPlayer:IsFriendsWith(p.UserId) end)
        friendCache[p.UserId] = ok and res or false
    end
    return friendCache[p.UserId]
end

local function refreshWhitelist()
    local currentPlayers = Players:GetPlayers()

    -- Ordenar: amigos primeiro, depois alfabético
    table.sort(currentPlayers, function(a, b)
        local aF = isFriend(a)
        local bF = isFriend(b)
        if aF ~= bF then return aF end
        return a.DisplayName:lower() < b.DisplayName:lower()
    end)

    -- Remove cards de quem saiu
    for uid, entry in pairs(wlBtnCache) do
        local stillIn = false
        for _, p in pairs(currentPlayers) do
            if p.UserId == uid then stillIn = true break end
        end
        if not stillIn or uid == LocalPlayer.UserId then
            entry.Frame:Destroy()
            wlBtnCache[uid] = nil
        end
    end

    -- Criar / atualizar cards
    local orderIdx = 0
    for _, p in pairs(currentPlayers) do
        if p ~= LocalPlayer then
            orderIdx = orderIdx + 1
            local entry = wlBtnCache[p.UserId]
            local friend = isFriend(p)

            if not entry then
                local card = Instance.new("TextButton", wlContainer)
                card.Size = UDim2.new(1, 0, 0, 52)
                card.BackgroundColor3 = Theme.Card
                card.Text = ""
                card.AutoButtonColor = false
                card.LayoutOrder = orderIdx
                Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)
                applyClickAnimation(card)

                -- Barra lateral dourada (amigo)
                local accentBar = Instance.new("Frame", card)
                accentBar.Size = UDim2.new(0, 3, 0, 34)
                accentBar.Position = UDim2.new(0, 0, 0.5, -17)
                accentBar.BackgroundColor3 = friend and Theme.Gold or Theme.Card
                accentBar.BorderSizePixel = 0
                Instance.new("UICorner", accentBar).CornerRadius = UDim.new(1, 0)

                local avatar = Instance.new("ImageLabel", card)
                avatar.Size = UDim2.new(0, 38, 0, 38)
                avatar.Position = UDim2.new(0, 10, 0.5, -19)
                avatar.BackgroundColor3 = Theme.Background
                avatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. p.UserId .. "&w=48&h=48"
                avatar.BorderSizePixel = 0
                Instance.new("UICorner", avatar).CornerRadius = UDim.new(1, 0)

                -- Badge estrela de amigo
                if friend then
                    local friendBadge = Instance.new("TextLabel", card)
                    friendBadge.Size = UDim2.new(0, 16, 0, 16)
                    friendBadge.Position = UDim2.new(0, 36, 0.5, -22)
                    friendBadge.BackgroundColor3 = Theme.Gold
                    friendBadge.Text = "★"
                    friendBadge.TextColor3 = Color3.fromRGB(60, 45, 0)
                    friendBadge.Font = Enum.Font.GothamBlack
                    friendBadge.TextSize = 11
                    friendBadge.BorderSizePixel = 0
                    friendBadge.ZIndex = 3
                    Instance.new("UICorner", friendBadge).CornerRadius = UDim.new(1, 0)
                    local fbStroke = Instance.new("UIStroke", friendBadge)
                    fbStroke.Color = Theme.Panel
                    fbStroke.Thickness = 2
                end

                local nameLbl = Instance.new("TextLabel", card)
                nameLbl.Size = UDim2.new(1, -140, 0, 22)
                nameLbl.Position = UDim2.new(0, 58, 0, 8)
                nameLbl.BackgroundTransparency = 1
                nameLbl.Text = (friend and "★ " or "") .. p.DisplayName
                nameLbl.TextColor3 = friend and Theme.Gold or Theme.Text
                nameLbl.Font = Enum.Font.GothamBold
                nameLbl.TextSize = 13
                nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                nameLbl.TextTruncate = Enum.TextTruncate.AtEnd

                local userLbl = Instance.new("TextLabel", card)
                userLbl.Size = UDim2.new(1, -140, 0, 16)
                userLbl.Position = UDim2.new(0, 58, 0, 28)
                userLbl.BackgroundTransparency = 1
                userLbl.Text = "@" .. p.Name
                userLbl.TextColor3 = friend and Color3.fromRGB(200, 180, 120) or Theme.SubText
                userLbl.Font = Enum.Font.Gotham
                userLbl.TextSize = 11
                userLbl.TextXAlignment = Enum.TextXAlignment.Left
                userLbl.TextTruncate = Enum.TextTruncate.AtEnd

                local badge = Instance.new("TextLabel", card)
                badge.Size = UDim2.new(0, 74, 0, 26)
                badge.Position = UDim2.new(1, -84, 0.5, -13)
                badge.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
                badge.Font = Enum.Font.GothamBold
                badge.TextSize = 11
                badge.TextColor3 = Color3.new(1, 1, 1)
                badge.Text = "ADICIONAR"
                Instance.new("UICorner", badge).CornerRadius = UDim.new(1, 0)

                local function updateState()
                    if whitelist[p.UserId] then
                        badge.Text = "IGNORADO"
                        badge.BackgroundColor3 = Theme.Success
                    else
                        badge.Text = "ADICIONAR"
                        badge.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
                    end
                end
                updateState()

                card.MouseButton1Click:Connect(function()
                    whitelist[p.UserId] = not whitelist[p.UserId]
                    updateState()
                end)

                wlBtnCache[p.UserId] = {
                    Frame = card,
                    Badge = badge,
                    Update = updateState,
                    Player = p,
                    Order = orderIdx,
                    Friend = friend,
                }
            else
                entry.Order = orderIdx
                entry.Frame.LayoutOrder = orderIdx
            end
        end
    end
end

task.spawn(function()
    while true do
        if tabs.Whitelist.Visible then
            local ok, err = pcall(refreshWhitelist)
            if not ok then warn("Whitelist: " .. tostring(err)) end
        end
        task.wait(3)
    end
end)

