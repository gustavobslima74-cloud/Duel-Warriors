local OldPanelBtns = {}
local function createOldPanelBtn(emoji, varName)
    local b = Instance.new("TextButton", OldPanel)
    b.Size = UDim2.new(0, 30, 0, 30)
    b.Text = emoji
    b.TextScaled = true
    b.BackgroundColor3 = Theme.Button
    b.AutoButtonColor = false
    Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
    Instance.new("UIAspectRatioConstraint", b).AspectRatio = 1
    applyClickAnimation(b)
    b.MouseButton1Click:Connect(function() getgenv()[varName] = not getgenv()[varName] end)
    table.insert(OldPanelBtns, {Btn = b, Var = varName})
end
