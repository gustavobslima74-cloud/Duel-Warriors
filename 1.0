local tabButtons = {}
local function createTabBtn(text, targetTab, key)
    local btn = Instance.new("TextButton", tabHolder)
    btn.Size = UDim2.new(0, 82, 0, 30)
    btn.BackgroundColor3 = Theme.Button
    btn.Text = text
    btn.TextColor3 = Theme.SubText
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.AutoButtonColor = false
    btn.LayoutOrder = key or 1
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    applyClickAnimation(btn)
    tabButtons[btn] = {tab = targetTab}
    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do t.Visible = false end
        targetTab.Visible = true
        for b, _ in pairs(tabButtons) do
            TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Button}):Play()
            b.TextColor3 = Theme.SubText
        end
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Accent}):Play()
        btn.TextColor3 = Color3.new(1, 1, 1)
    end)
    return btn
end

