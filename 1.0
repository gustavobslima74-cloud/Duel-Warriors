-- ============================================================
-- BOTÕES FLUTUANTES
-- ============================================================
function spawnFloatingBtn(emoji, varName)
    if ActiveFloatingButtons[varName] then return end
    local frame = Instance.new("Frame", gui)
    frame.Size = UDim2.new(0, 34, 0, 34)
    frame.Position = UDim2.new(0.5, math.random(-80, 80), 0.5, math.random(-80, 80))
    frame.BackgroundColor3 = Theme.Panel
    frame.BorderSizePixel = 0
    Instance.new("UICorner", frame).CornerRadius = UDim.new(1, 0)
    Instance.new("UIAspectRatioConstraint", frame).AspectRatio = 1
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = emoji
    btn.TextScaled = true
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    makeDraggable(frame, btn)
    applyClickAnimation(btn)
    local xBtn = Instance.new("TextButton", frame)
    xBtn.Size = UDim2.new(0, 14, 0, 14)
    xBtn.Position = UDim2.new(1, -8, 0, -5)
    xBtn.BackgroundColor3 = Theme.Danger
    xBtn.Text = "X"
    xBtn.TextColor3 = Color3.new(1, 1, 1)
    xBtn.Font = Enum.Font.GothamBold
    xBtn.TextScaled = true
    Instance.new("UICorner", xBtn).CornerRadius = UDim.new(1, 0)
    applyClickAnimation(xBtn)
    btn.MouseButton1Click:Connect(function() getgenv()[varName] = not getgenv()[varName] end)
    xBtn.MouseButton1Click:Connect(function() frame:Destroy(); ActiveFloatingButtons[varName] = nil end)
    ActiveFloatingButtons[varName] = {Frame = frame, Btn = btn}
end

-- ============================================================
-- KEYBINDS
-- ============================================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if getgenv()._bindingKey then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if input.KeyCode == getgenv().Keybinds.CharAimLock and input.KeyCode ~= Enum.KeyCode.Unknown then
        getgenv().CharAimLock = not getgenv().CharAimLock
    elseif input.KeyCode == getgenv().Keybinds.CamAimbot and input.KeyCode ~= Enum.KeyCode.Unknown then
        getgenv().CamAimbot = not getgenv().CamAimbot
    elseif input.KeyCode == getgenv().Keybinds.AutoAttack and input.KeyCode ~= Enum.KeyCode.Unknown then
        getgenv().AutoAttack = not getgenv().AutoAttack
    end
end)

-- ============================================================
-- LÓGICA DE JOGO
-- ============================================================
local lastTick = tick()
local frameCount = 0
local currentFPS = 60

RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    if tick() - lastTick >= 1 then
        currentFPS = frameCount
        frameCount = 0
        lastTick = tick()
    end

    if getgenv().ShowStats then
        local ping = "N/A"
        pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
        statsLbl.Text = string.format("FPS: %d | Ping: %s ms | País: %s", currentFPS, tostring(ping), serverCountry)
    end

    for varName, data in pairs(MenuToggles) do
        local state = getgenv()[varName]
        if data.Switch and data.Knob and state ~= data.State then
            data.State = state
            TweenService:Create(data.Switch, TweenInfo.new(0.18), {
                BackgroundColor3 = state and Theme.Success or Color3.fromRGB(55, 55, 68)
            }):Play()
            TweenService:Create(data.Knob, TweenInfo.new(0.18), {
                Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
                BackgroundColor3 = state and Color3.new(1, 1, 1) or Color3.fromRGB(200, 200, 210)
            }):Play()
        end
    end

    local rgb = Color3.fromHSV(tick() % 5 / 5, 0.7, 1)
    mainStroke.Color = rgb
    oldStroke.Color = rgb
    floatMenuStroke.Color = rgb

    local isRec = getgenv().RecordingMode
    OldPanel.BackgroundTransparency = isRec and 1 or 0
    oldStroke.Transparency = isRec and 1 or 0
    moveHandle.Visible = not isRec
    statsLbl.TextTransparency = isRec and 1 or 0
    statsLbl.TextStrokeTransparency = isRec and 1 or 0.3
    floatMenuFrame.BackgroundTransparency = isRec and 1 or 0
    floatMenuStroke.Transparency = isRec and 1 or 0
    floatMenuBtn.TextTransparency = isRec and 1 or 0

    for _, data in pairs(OldPanelBtns) do
        data.Btn.BackgroundTransparency = isRec and 1 or 0
        data.Btn.TextTransparency = isRec and 1 or 0
        if not isRec then
            data.Btn.BackgroundColor3 = getgenv()[data.Var] and Theme.Success or Theme.Button
        end
    end
    for varName, data in pairs(ActiveFloatingButtons) do
        data.Frame.BackgroundTransparency = isRec and 1 or 0
        data.Btn.TextTransparency = isRec and 1 or 0
        local x = data.Frame:FindFirstChildOfClass("TextButton")
        if x then x.Visible = not isRec end
        if not isRec then
            data.Frame.BackgroundColor3 = getgenv()[varName] and Theme.Success or Theme.Panel
        end
    end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local eRoot = currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart")
    local dist = (root and eRoot) and (root.Position - eRoot.Position).Magnitude or math.huge

    if hum then
        if getgenv().EnableSpeed then
            hum.WalkSpeed = getgenv().WalkSpeedValue
            isComboBoosting = false
        else
            if getgenv().ComboSpeedBoost and (tick() - lastComboBoostTick < 0.25) then
                if not isComboBoosting then
                    preBoostSpeed = hum.WalkSpeed
                    isComboBoosting = true
                else
                    if hum.WalkSpeed ~= (preBoostSpeed + getgenv().ComboBoostAmount) and hum.WalkSpeed ~= preBoostSpeed then
                        preBoostSpeed = hum.WalkSpeed
                    end
                end
                if preBoostSpeed > 0 then
                    hum.WalkSpeed = preBoostSpeed + getgenv().ComboBoostAmount
                else
                    hum.WalkSpeed = 0
                end
            else
                if isComboBoosting then
                    if hum.WalkSpeed == (preBoostSpeed + getgenv().ComboBoostAmount) then
                        hum.WalkSpeed = preBoostSpeed
                    end
                    isComboBoosting = false
                end
            end
        end
    end

    local isStunned = false
    if hum then
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown or state == Enum.HumanoidStateType.Physics then
            isStunned = true
        end
    end

    if getgenv().StickMode and root and eRoot and not isStunned then
        root.CFrame = root.CFrame:Lerp(eRoot.CFrame * CFrame.new(0, 0, getgenv().StickDistance), 1 - (getgenv().StickSmoothness / 100))
    end

    if getgenv().CharAimLock and root and eRoot and dist <= getgenv().AimbotRange and not isStunned then
        local targetPos = eRoot.Position
        if getgenv().CharAimPrediction then targetPos = targetPos + (eRoot.AssemblyLinearVelocity * 0.15) end
        local bg = root:FindFirstChild("DW_AimGyro") or Instance.new("BodyGyro", root)
        bg.Name = "DW_AimGyro"
        bg.MaxTorque = Vector3.new(0, math.huge, 0)
        bg.P = 50000000
        bg.D = 100
        bg.CFrame = CFrame.lookAt(root.Position, Vector3.new(targetPos.X, root.Position.Y, targetPos.Z))
    elseif root and root:FindFirstChild("DW_AimGyro") then
        root.DW_AimGyro:Destroy()
    end

    if getgenv().CamAimbot and eRoot and dist <= getgenv().AimbotRange then
        local cam = workspace.CurrentCamera
        local camPos = cam.CFrame.Position
        local targetPos = eRoot.Position
        if getgenv().AimPrediction then targetPos = targetPos + (eRoot.AssemblyLinearVelocity * 0.15) end
        local currentPitch = cam.CFrame:ToEulerAnglesYXZ()
        local horizontalLook = CFrame.lookAt(camPos, Vector3.new(targetPos.X, camPos.Y, targetPos.Z))
        cam.CFrame = horizontalLook * CFrame.Angles(currentPitch, 0, 0)
    end

    if getgenv().MyHealth and hum then
        myHealthLbl.Visible = true
        myHealthLbl.Text = "MEU HP: " .. math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
        myHealthLbl.TextColor3 = hum.Health > (hum.MaxHealth * 0.6) and Color3.new(0, 1, 0)
            or (hum.Health > (hum.MaxHealth * 0.3) and Color3.new(1, 1, 0) or Color3.new(1, 0, 0))
    else
        myHealthLbl.Visible = false
    end

    if getgenv().AntiFling and hum then
        hum:SetStateEnabled(10, false)
        hum:SetStateEnabled(1, false)
        if hum:GetState() == Enum.HumanoidStateType.Ragdoll then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
end)

UserInputService.JumpRequest:Connect(function()
    if getgenv().InfiniteJump and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid:ChangeState(3)
    end
end)

-- LEGIT CHASE
task.spawn(function()
    while true do
        if getgenv().LegitChase and currentTarget then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local eRoot = currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart")
            if hum and root and eRoot and hum.Health > 0 then
                local dist = (root.Position - eRoot.Position).Magnitude
                if dist > getgenv().AttackRange and dist <= 60 then
                    hum:MoveTo(eRoot.Position)
                end
            end
        end
        task.wait(0.1)
    end
end)

-- FAST ANIMATIONS
RunService.Heartbeat:Connect(function()
    if getgenv().FastAnimations then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local animator = hum and hum:FindFirstChild("Animator")
        if animator then
            for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                if track.Priority == Enum.AnimationPriority.Action
                   or track.Priority == Enum.AnimationPriority.Action2
                   or track.Priority == Enum.AnimationPriority.Action3
                   or track.Priority == Enum.AnimationPriority.Action4 then
                    track:AdjustSpeed(getgenv().AnimSpeed)
                end
            end
        end
    end
end)

-- AUTO ATTACK
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if getgenv().AutoAttack and currentTarget and root then
        local targetDelay = getgenv().AttackDelay / 1000
        if tick() - lastAttackTime >= targetDelay then
            local eRoot = currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart")
            if eRoot then
                local realTimeDist = (root.Position - eRoot.Position).Magnitude
                if realTimeDist <= getgenv().AttackRange then
                    local r = getOptimizedRemote()
                    if r then
                        r:FireServer({Key = "TouchATK", State = Enum.UserInputState.Begin})
                        r:FireServer({Key = "TouchATK", State = Enum.UserInputState.End})
                        lastAttackTime = tick()
                        if getgenv().ComboSpeedBoost and realTimeDist <= getgenv().ComboBoostDistance then
                            lastComboBoostTick = tick()
                        end
                    end
                end
            end
        end
    end
end)

-- TELEPORT ON ATTACK
task.spawn(function()
    while true do
        local b = LocalPlayer.PlayerGui:FindFirstChild("ATK", true)
        if b and b:IsA("GuiButton") and not b:FindFirstChild("TpHook") then
            Instance.new("BoolValue", b).Name = "TpHook"
            b.MouseButton1Down:Connect(function()
                if getgenv().TeleportOnAttack and currentTarget then
                    local t = currentTarget
                    if t and t.Character then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = t.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, getgenv().StickDistance)
                    end
                end
            end)
        end
        task.wait(1)
    end
end)

-- ESP
RunService.RenderStepped:Connect(function()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local plrsDist = {}
    if myRoot then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character.Humanoid.Health > 0 then
                table.insert(plrsDist, {plr = p, dist = (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude})
            end
        end
        table.sort(plrsDist, function(a, b) return a.dist < b.dist end)
    end

    local top5 = {}
    for i = 1, math.min(5, #plrsDist) do top5[plrsDist[i].plr] = true end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if p.Character:FindFirstChild("HumanoidRootPart") then
                local hl = p.Character:FindFirstChild("DW_Highlight") or Instance.new("Highlight", p.Character)
                hl.Name = "DW_Highlight"
                hl.FillTransparency = 0.5
                if isWhitelisted(p) and getgenv().HighlightFriendly then
                    hl.FillColor = Color3.new(0, 1, 0); hl.Enabled = true
                elseif p == currentTarget and getgenv().HighlightEnemy then
                    hl.FillColor = Color3.new(1, 0, 0); hl.Enabled = true
                else
                    hl.Enabled = false
                end

                local bb = p.Character.HumanoidRootPart:FindFirstChild("DW_HealthESP")
                if (getgenv().HealthESP or getgenv().SkillESP) and top5[p] then
                    if not bb then
                        bb = Instance.new("BillboardGui", p.Character.HumanoidRootPart)
                        bb.Name = "DW_HealthESP"
                        bb.Size = UDim2.new(0, 120, 0, 60)
                        bb.StudsOffset = Vector3.new(3, -1.5, 0)
                        bb.AlwaysOnTop = true

                        local hpText = Instance.new("TextLabel", bb)
                        hpText.Name = "HPText"
                        hpText.Size = UDim2.new(1, 0, 0.4, 0)
                        hpText.BackgroundTransparency = 1
                        hpText.Font = Enum.Font.GothamBold
                        hpText.TextSize = 12
                        hpText.TextStrokeTransparency = 0

                        local skillText = Instance.new("TextLabel", bb)
                        skillText.Name = "SkillText"
                        skillText.Size = UDim2.new(1, 0, 0.6, 0)
                        skillText.Position = UDim2.new(0, 0, 0.4, 0)
                        skillText.BackgroundTransparency = 1
                        skillText.Font = Enum.Font.GothamMedium
                        skillText.TextSize = 11
                        skillText.TextStrokeTransparency = 0
                        skillText.TextColor3 = Color3.fromRGB(255, 200, 0)
                        skillText.TextYAlignment = Enum.TextYAlignment.Top
                    end

                    if getgenv().HealthESP then
                        local h = math.floor(p.Character.Humanoid.Health)
                        local m = math.floor(p.Character.Humanoid.MaxHealth)
                        bb.HPText.Text = h .. " / " .. m
                        bb.HPText.TextColor3 = h > (m * 0.6) and Color3.new(0, 1, 0)
                            or (h > (m * 0.3) and Color3.new(1, 1, 0) or Color3.new(1, 0, 0))
                        bb.HPText.Visible = true
                    else
                        bb.HPText.Visible = false
                    end

                    if getgenv().SkillESP then
                        local sText = ""
                        local tool = p.Character:FindFirstChildOfClass("Tool")
                        if tool then sText = "[" .. tool.Name .. "]" end
                        for _, v in pairs(p.Character:GetChildren()) do
                            if v:IsA("NumberValue") or v:IsA("IntValue") then
                                local vName = string.lower(v.Name)
                                if string.find(vName, "cd") or string.find(vName, "cool") or string.find(vName, "time") then
                                    if v.Value > 0 then
                                        sText = sText .. "\n⏳ " .. string.sub(v.Name, 1, 6) .. ": " .. string.format("%.1f", v.Value) .. "s"
                                    end
                                end
                            end
                        end
                        bb.SkillText.Text = sText
                        bb.SkillText.Visible = true
                    else
                        bb.SkillText.Visible = false
                    end
                elseif bb then
                    bb:Destroy()
                end
            end
        end
    end
end)

-- GESTO MOBILE
local touchStart = nil
UserInputService.TouchStarted:Connect(function(touch, gameProcessed)
    if not gameProcessed then touchStart = touch.Position end
end)
UserInputService.TouchEnded:Connect(function(touch, gameProcessed)
    if not touchStart then return end
    local drop = touch.Position - touchStart
    local screen = workspace.CurrentCamera.ViewportSize
    if drop.Y > 80 and math.abs(drop.X) < 60 and touchStart.Y < (screen.Y * 0.3) then
        toggleMenu()
    end
    touchStart = nil
end)
